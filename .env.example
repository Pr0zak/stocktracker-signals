# Copy to .env and fill in. Never commit the real .env.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Model tiers (see the claude-api reference for current IDs).
DEEP_MODEL=claude-opus-4-8      # on-demand single-ticker deep dive
SCAN_MODEL=claude-haiku-4-5     # cheap nightly watchlist scan

# Cache TTL for a verdict (seconds). Signals are daily — a few hours is plenty.
VERDICT_TTL_SECONDS=14400

# SEC-2: shared bearer token gating every non-GET route plus the settings/sandbox GET routes (the
# ones that disclose the watchlist or the paper book). Loopback callers (the systemd timer units,
# via curl http://127.0.0.1:8000/...) are exempt and never need this. Required — the service refuses
# to start without it. Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SIGNALS_API_TOKEN=change-me-generate-a-real-secret
