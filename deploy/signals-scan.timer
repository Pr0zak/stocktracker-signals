[Unit]
Description=Run the StockTracker Signals scan on weekday mornings

[Timer]
# Weekdays only. The scan re-asks the model about Friday's unchanged bars on a weekend, and its
# answers drift between runs, so weekend runs produced "signals changed overnight" alerts while the
# market was shut. Holidays are skipped inside scan_job itself.
OnCalendar=Mon-Fri 06:30:00
Persistent=true

[Install]
WantedBy=timers.target
