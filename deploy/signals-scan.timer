[Unit]
Description=Run the StockTracker Signals scan each morning (crypto only on closed days)

[Timer]
# Every day. On a weekend or market holiday scan_job scores crypto only (it trades every day) and
# carries the stock rows forward unchanged: re-asking the model about the last close's unchanged
# bars just reports its drift as "signals changed overnight".
OnCalendar=*-*-* 06:30:00
Persistent=true

[Install]
WantedBy=timers.target
